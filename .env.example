# Google Sheets Database Configuration (Required for Google Sheets integration)
# 1. Share your Google Spreadsheet with this service account email with 'Editor' permissions
GOOGLE_SERVICE_ACCOUNT_EMAIL="pharmapulse-erp@your-project-id.iam.gserviceaccount.com"

# 2. Paste the private key from your service account JSON file (with \n escaped or as multi-line)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. The ID from your Google Spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"

# 4. Optional: Google Cloud Project ID (used for reference or metadata)
GOOGLE_PROJECT_ID="your-gcp-project-id"

# Application Settings
PORT=3000
NODE_ENV="development"

# GEMINI_API_KEY: Optional AI assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

